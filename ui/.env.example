# Settings for the AI Gateway Doctor UI. Copy to .env (git-ignored) and edit.
# The server re-reads this file on every request, so edits apply without a restart.
#
# Sandboxes: every <name>.config.json in AIGW_CONFIG_DIR is listed
# (my-sandbox.config.json -> "my-sandbox"), plus any names in SANDBOXES (give those a <NAME>_CONFIG path).
AIGW_CONFIG_DIR=~/aigw-doctor/configs
# SANDBOXES=dev-1,dev-2

# Defaults for every sandbox. A sandbox overrides any of them with <NAME>_<KEY>, where NAME is the
# sandbox name in upper case with other characters as "_" (my-sandbox -> MY_SANDBOX_REGION).
REGION=us-east-2
CP_USER=you@example.com
# Secrets stay on this machine: the browser only sees that they are set, and the doctor gets
# them through its environment. Leave them out to type them in the form instead.
# CP_PASSWORD=
# AIGW_API_KEY=

# How runs start: SCOPE=all|inference|infra, MODE=check|dry-run, API_KEY_SOURCE=create|file|paste
SCOPE=all
MODE=check
API_KEY_SOURCE=create
# MODELS=<model name>,<model name>
# THRESHOLD=85
# API_KEY_FILE=~/.aigw-key

# Fleet Manager links: fm.<sandbox>.<SANDBOX_DOMAIN> when a sandbox has no control plane URL.
# SANDBOX_DOMAIN=<domain of your sandboxes>

# Terminals over SSH (SSM needs none of this)
# SSH_USER=ec2-user
# SSH_KEY=~/.ssh/<key>.pem

# Example sandbox "my-sandbox" (its config is ~/aigw-doctor/configs/my-sandbox.config.json)
# MY_SANDBOX_LABEL=My sandbox
# MY_SANDBOX_TENANT_ID=<tenant (org) UUID>
# MY_SANDBOX_CP_URL=https://api.<env>.<domain>/v2/organizations/<org id>
# MY_SANDBOX_REGION=us-east-2
# MY_SANDBOX_CONFIG=/path/to/my-sandbox.config.json
# MY_SANDBOX_AIGW_URL=https://<gateway endpoint>
# MY_SANDBOX_FM_URL=https://fm.<env>.<domain>/
# MY_SANDBOX_CP_PASSWORD=
# MY_SANDBOX_AIGW_SSH=ec2-user@<gateway public DNS>
# MY_SANDBOX_CB_SSH=ec2-user@<cache node public DNS>
